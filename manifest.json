{
  "manifest_version": 3,
  "name": "Momentum Dashboard",
  "version": "1.0",
  "description": "Replaces the New Tab page with a beautiful personal productivity dashboard.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
